# Copia a backend/.env (no subas .env al repo).
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000

# Ruta absoluta al JSON de cuenta de servicio (Firebase Console > Proyecto > Cuentas de servicio).
FIREBASE_CREDENTIALS_PATH=C:\ruta\a\serviceAccount.json

# Documento a leer (colección/id en Firestore). Por defecto: avance/demo
FIRESTORE_DOC_PATH=avance/demo
